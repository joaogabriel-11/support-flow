DATABASE_URL="postgresql://usuario:senha@host:5432/support_flow"
DIRECT_DATABASE_URL="postgresql://usuario:senha@host:5432/support_flow"
# Gere com: npx auth secret
AUTH_SECRET="substitua-por-um-segredo-forte"

# Envio de notificacoes por e-mail via Resend.
RESEND_API_KEY="re_substitua-pela-chave-do-projeto"
EMAIL_FROM="Support Flow <noreply@joaogabriels.com>"
# URL publica usada nos links dos e-mails.
APP_URL="http://localhost:3000"

# Usada apenas por `npx prisma db seed` para criar o administrador inicial.
SEED_ADMIN_PASSWORD="defina-uma-senha-inicial"
SEED_REQUESTER_PASSWORD="defina-uma-senha-para-o-solicitante"
